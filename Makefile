.DELETE_ON_ERROR:

# The JS runtime used for check-js and test, duk is the command line interpreter of Duktape, which Zabbix uses
DUK ?= duk

# Injects the discovery script (after trimming it) into the template
template.dist.yaml: template.yaml .discovery_script.trimmed.js
	@printf '# This is a generated file, do not modify manually.\n# All modifications should happen in these files\n#  template.yaml discovery_script.js\n' > $@
	yq '.zabbix_export.templates[0].discovery_rules[].params |= loadstr(".discovery_script.trimmed.js")' template.yaml >> $@

# Removes type annotations and noinspection comments
.discovery_script.trimmed.js: discovery_script.js
	 grep -v '^[[:space:]]*// noinspection' $< | grep -v '^/\*' | grep -v '^ *\*'  > $@

# Run yamllint on the template and the generated file
lint: template.yaml template.dist.yaml
	yamllint template.yaml template.dist.yaml
.PHONY: lint

# Check whether the discovery script can be parsed by the JS runtime used by Zabbix
check-js: .discovery_script.check.js
	$(info Line numbers emitted by duk do not match the source file discovery_script.js, so check $< in case of error)
	$(DUK) $<
.PHONY: check-js

# Wrap the trimmed discovery script in a function so it can be executed by duk
# This intentionally uses the trimmed version of the script to catch issues introduced by trimming.
.discovery_script.check.js: .discovery_script.trimmed.js config.example.json
	$(info wrapping discovery script in function to make it executable by duk)
	@printf '/*\n * Autogenerated file for testing purposes, do not commit or deploy!\n*/\n' > $@
	@printf 'var value = JSON.stringify(' >> $@
	@jq --compact-output '{ config: tojson }' config.example.json >> $@
	@printf ');\n\n' >> $@
	@printf 'function main(){' >> $@
	@cat $< >> $@
	@printf '\n}\nmain();' >> $@

# Run the trimmed discovery script on every configuration in tests/cases.json; each one has to be accepted or rejected
# as its "expect" says
test: .discovery_script.test.js
	$(DUK) $<
.PHONY: test

.discovery_script.test.js: .discovery_script.trimmed.js tests/cases.json tests/run.js
	@printf '/*\n * Autogenerated file for testing purposes, do not commit or deploy!\n*/\n' > $@
	@printf 'var cases = ' >> $@
	@jq --compact-output '.' tests/cases.json >> $@
	@printf ';\n\nfunction discover(value) {' >> $@
	@cat $< >> $@
	@printf '\n}\n\n' >> $@
	@cat tests/run.js >> $@
